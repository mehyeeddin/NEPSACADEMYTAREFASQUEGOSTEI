    string Numero;

    cin >> Numero;

    for(int i = 0; i < Numero.length(); i++) {
        if(Numero[i] == '-') cout << '-'; else if
        (Numero[i] - '0' >= 0 && Numero[i] - '0' <= 9) cout << Numero[i]; else cout << Dicionario[Numero[i]];
    }
    return 0;
}
