#include <iostream>
#include <map>
#include <string>

using namespace std;

int main(){
    // Primeira vez usando map
    map<char, int> Dicionario = {
        {'A', 2 },
        {'B', 2 },
        {'C', 2 },
        {'D', 3 },
        {'E', 3 },
        {'F', 3 },
        {'G', 4 },
        {'H', 4 },
        {'I', 4 },
        {'J', 5 },
        {'K', 5 },
        {'L', 5 },
        {'M', 6 },
        {'N', 6 },
        {'O', 6 },
        {'P', 7 },
        {'Q', 7 },
